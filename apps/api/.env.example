# 首次运行必填。已有管理员账号的数据库不会重新初始化管理员。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 首次配置云存储前必填！生产环境请永久保管同一把密钥，否则历史凭证无法解密。
# 使用：node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
STORAGE_ENCRYPTION_KEY=

STORAGE_DIR=./data
PORT=3200
WEB_ORIGIN=http://localhost:5173
# HTTPS 生产环境必须设置为 true；Cookie 需要前端与 API 同站点代理。
COOKIE_SECURE=false
