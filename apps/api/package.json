{
  "name": "@studydocs/api",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke": "node test/smoke.cjs",
    "test:filename": "node --experimental-strip-types --test test/upload-filename.test.mjs",
    "test:transfer": "node test/transfer.cjs && node test/transfer-http.cjs && node test/transfer-cloud.cjs && node test/signing.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.800.0",
    "@aws-sdk/s3-request-presigner": "^3.1153.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@studydocs/shared": "workspace:*",
    "ali-oss": "^6.23.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sanitize-html": "^2.16.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@types/ali-oss": "^6.16.0",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.0",
    "@types/sanitize-html": "^2.16.0",
    "typescript": "~5.8.3"
  }
}
